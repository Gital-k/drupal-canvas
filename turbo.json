{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build:app": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "//#lint:cspell": { "cache": false },
    "//#lint:eslint": { "cache": false },
    "//#lint:openapi": { "cache": false },
    "//#lint:prettier": { "cache": false },
    "//#lint:stylelint": { "cache": false },
    "//#lint:yaml": { "cache": false },
    "//#packages:lint:cspell": { "cache": false },
    "//#packages:lint:eslint": { "cache": false },
    "//#packages:lint:prettier": { "cache": false },
    "//#packages:lint:stylelint": { "cache": false },
    "//#packages:lint:yaml": { "cache": false },
    "//#test:playwright": { "cache": false }
  }
}
