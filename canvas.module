<?php

use Drupal\canvas\Entity\Component;
use Drupal\canvas\Hook\CanvasHooks;
use Drupal\canvas\Plugin\Canvas\ComponentSource\JsonSchemaPropsComponentSourceBase;
use Drupal\canvas\PropSource\FieldStorageDefinition;
use Drupal\Core\Entity\FieldableEntityInterface;
use Drupal\Core\Field\FieldStorageDefinitionInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;

/**
 * Provides allowed values for a 'list_*' field used in a StaticPropSource.
 *
 * @see callback_allowed_values_function()
 * @see \Drupal\canvas\Plugin\Canvas\ComponentSource\JsonSchemaPropsComponentSourceBase::getOptionsForExplicitInputEnumProps()
 */
function canvas_load_allowed_values_for_component_prop(FieldStorageDefinitionInterface $canvas_field_storage_definition, ?FieldableEntityInterface $entity = NULL, bool &$cacheable = FALSE): array {
  // Allowed values can't be cached, as they not only depend on the prop but
  // also on which component is using it.
  $cacheable = FALSE;
  // We only accept this callback for props, not for real fields.
  assert($canvas_field_storage_definition instanceof FieldStorageDefinition);
  // @phpstan-ignore-next-line
  $canvas_form_display_options = $canvas_field_storage_definition->getDisplayOptions('form')['third_party_settings']['canvas'];
  [
    'component_id' => $component_id,
    'component_version' => $component_version,
    'explicit_input_prop_name' => $prop_name,
  ] = $canvas_form_display_options;
  $component = Component::load($component_id);

  // @see https://en.wikipedia.org/wiki/Robustness_principle
  if ($component === NULL) {
    return [];
  }

  $component->loadVersion($component_version);

  // StaticPropSources are only used for ComponentSources with a generated input
  // UX using fields.
  $source = $component->getComponentSource();
  assert($source instanceof JsonSchemaPropsComponentSourceBase);

  return $source->getOptionsForExplicitInputEnumProp($prop_name);
}

/**
 * Implements hook_preprocess_HOOK() for regions.
 *
 * @see \Drupal\canvas\Render\MainContent\CanvasPreviewRenderer::prepare()
 */
#[LegacyHook]
function canvas_preprocess_region(array &$variables): void {
  \Drupal::service(CanvasHooks::class)->preprocessRegion($variables);
}

/**
 * Implements hook_preprocess_form_element().
 */
#[LegacyHook]
function canvas_preprocess_form_element(array &$variables): void {
  \Drupal::service(CanvasHooks::class)->preprocessFormElement($variables);
}

/**
 * Implements hook_preprocess_HOOK() for html.
 */
#[LegacyHook]
function canvas_preprocess_html(array &$variables): void {
  \Drupal::service(CanvasHooks::class)->preprocessHtml($variables);
}
