+$schema: https://git.drupalcode.org/project/drupal/-/raw/HEAD/core/assets/schemas/v1/metadata.schema.json
+name: Link List
+description: Displays lists of links demonstrating URI format validation and plain string URLs.
+status: experimental
+props:
+  type: object
+  properties:
+    absolute_urls:
+      type: array
+      title: Absolute URLs (URI format)
+      items:
+        type: string
+        format: uri
+      examples:
+        -
+          - https://www.drupal.org
+          - https://www.example.com
+    urls:
+      type: array
+      title: Relative or Absolute URLs
+      items:
+        type: string
+        format: uri-reference
+      examples:
+        -
