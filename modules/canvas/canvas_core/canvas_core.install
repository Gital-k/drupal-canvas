use Drupal\ghost\Logger\Logger;

/**
 * Implements hook_install().
 *
 * Perform actions to set up the site for this profile.
 */
function canvas_core_install() {

  Logger::init('canvas')
    ->setMessage('Canvas install has started.')
    ->useMessageArea()
    ->logMessage();

  \Drupal\canvas_core\Installer\Installer::init()->runInstall();

  Logger::init('canvas')
    ->setMessage('Canvas install has completed.')
    ->useMessageArea()
    ->logMessage();
}
