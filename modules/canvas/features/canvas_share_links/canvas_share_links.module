<?php
/**
 * @file
 * Code for the canvas Share Links feature.
 */

include_once 'canvas_share_links.features.inc';

/**
 * Implements hook_service_links().
 */
function canvas_share_links_service_links() {
  $links = array();
  $links['email'] = array(
    'name' => 'email',
    'description' => t('Share via email'),
    'link' => 'mailto:?subject=<encoded-title>&body=<encoded-url>',
  );
  return $links;
}
