<div class="serp-preview-wrapper">
	<div class="form-item__label serp-preview__label">{{'Search Result Preview'|t}}</div>
	<p class="form-item__description serp-preview__description-text">
		{{'This preview uses the typical character limits for Google search result pages on desktop. Search engines may decide to show different content.'|t}}
	</p>
	<div class="serp-preview">
		<div class="serp-preview__title">{{meta_title}}</div>
		<div class="serp-preview__url">{{page_url}}</div>
		<div class="serp-preview__description">{{meta_description|raw}}</div>
	</div>
</div>
