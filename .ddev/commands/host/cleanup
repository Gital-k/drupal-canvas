#!/bin/bash

## Description: Remove environment-specific folders and files ignored by .gitignore.
## Usage: cleanup [--force]
## Example: ddev cleanup
## Example: ddev cleanup --force
## Flags: [{"Name":"force","Shorthand":"f","Usage":"Skip confirmation prompt"}]
## ExecRaw: true

set -e

# Flag handling
FORCE=false
while :; do
  case ${1:-} in
    -f | --force)
      FORCE=true ;;
    --)
      shift
      break ;;
    -?*)
      printf 'WARN: Unknown option (ignored): %s\n' "$1" >&2 ;;
    *)
      break ;;
  esac
  shift
done

# Confirm before proceeding unless --force is passed
if [[ "$FORCE" != true ]]; then
  echo "This will remove all environment-specific files (web, vendor, node_modules, build artifacts, etc.)"
  read -p "Are you sure you want to continue? [y/N] " -n 1 -r
  echo
  if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo "Cleanup cancelled."
    exit 0
  fi
fi

echo "Cleaning up environment-specific files..."

# The Drupal scaffold (web/, vendor/, .cache) lives in a Docker volume mounted
# at /var/www/html, not on the host. This module is bind-mounted at
# web/modules/contrib/canvas. Empty the scaffold from inside the container while
# preserving the path down to (and contents of) the module mount — recursing
# into the bind mount would delete the real host repository.
#
# The volume cannot be `docker volume rm`'d here because setup calls
# `ddev cleanup --force` while the container is running; emptying in place
# achieves the same fresh-scaffold result and lets `ddev poser` rebuild it.
if ddev exec true >/dev/null 2>&1; then
  ddev exec '
    set -e
    # Drupal hardens sites/default to 0555 and settings*.php to 0444 after a
    # site install. Those read-only bits stop rm from emptying the tree, so
    # restore write permission first. Scoped to web/sites (entirely removed
    # below) so it never recurses into the web/modules/contrib/canvas bind
    # mount (the real host repo).
    [ -d /var/www/html/web/sites ] && chmod -R u+w /var/www/html/web/sites
    find /var/www/html -mindepth 1 -maxdepth 1 ! -name web -exec rm -rf {} +
    find /var/www/html/web -mindepth 1 -maxdepth 1 ! -name modules -exec rm -rf {} +
    find /var/www/html/web/modules -mindepth 1 -maxdepth 1 ! -name contrib -exec rm -rf {} + 2>/dev/null || true
    find /var/www/html/web/modules/contrib -mindepth 1 -maxdepth 1 ! -name canvas -exec rm -rf {} + 2>/dev/null || true
  '
fi

# Force setup to re-run after a cleanup.
rm -f .ddev/.scaffold-built

# Host-side node dependencies and caches (shared with the container via the
# bind mount; lint scripts write .cache into the module dir).
rm -rf node_modules
rm -rf .cache

# UI build artifacts
rm -rf ui/dist
rm -rf ui/dist-ssr
rm -rf ui/logs
rm -rf ui/junit*
rm -f ui/.env

# Packages
rm -rf packages/*/dist
rm -rf packages/*/node_modules
rm -rf packages/*/.astro

# Documentation
rm -rf docs/user/dist
rm -rf docs/user/.astro
rm -rf docs/user/node_modules

# CLI
rm -rf cli/dist
rm -rf cli/node_modules
rm -f cli/.env

# Test artifacts
rm -rf test-results
rm -rf playwright-report
rm -rf blob-report
rm -rf playwright/.cache
rm -rf playwright/.auth

# Logs
rm -rf logs
rm -f *.log
rm -f npm-debug.log*
rm -f yarn-debug.log*
rm -f yarn-error.log*
rm -f pnpm-debug.log*
rm -f lerna-debug.log*

# GitLab CI local
rm -rf .gitlab-ci-local
rm -rf _drupal

echo "Cleanup complete."
