#!/usr/bin/env bash

## #ddev-generated
## Description: Set up the Canvas development environment.
## Usage: setup
## Example: ddev setup\nddev setup --force
## Flags: [{"Name":"force","Shorthand":"f","Usage":"Completely reset an existing environment if present and start over"}]
## ExecRaw: true

set -e

# Flag handling
FORCE=false
while :; do
  case ${1:-} in
    -f | --force)
      FORCE=true ;;
    --)
      shift
      break ;;
    -?*)
      printf 'WARN: Unknown option (ignored): %s\n' "$1" >&2 ;;
    *)
      break ;;
  esac
  shift
done

# Exit early if already set up (unless --force)
if [[ -f vendor/autoload.php ]] && [[ "$FORCE" != true ]]; then
  echo "Development environment already set up."
  echo "Run 'ddev setup --force' to reset and start over."
  exit 0
fi

echo "Setting up Canvas development environment..."

# Save original composer.json to restore after setup
cp composer.json composer.json.original

# Remove any environment-specific files
ddev cleanup --force

# Install ddev-playwright add-on if not already installed
if [[ ! -f .ddev/config.playwright.yml ]]; then
  echo "Installing ddev-playwright add-on... This will setup playwright and restart ddev one time."
  ddev add-on get Lullabot/ddev-playwright
  cp .ddev/web-build/disabled.Dockerfile.playwright .ddev/web-build/Dockerfile.playwright
  ddev restart
fi

# Allow all Composer plugins.
ddev composer config \
  --no-plugins \
  allow-plugins.\* \
  true

# Run ddev-drupal-contrib scripts
ddev poser
ddev symlink-project

# Regenerate ddev Drupal settings after directory structure is set up
ddev config --update

# Create simpletest directory for Playwright/PHPUnit test site installations
mkdir -p web/sites/simpletest
chmod 777 web/sites/simpletest

# Allow test modules and themes to be installed.
# shellcheck disable=SC2016
printf '\n// Allow test modules and themes to be installed.\n$settings["extension_discovery_scan_tests"] = TRUE;' \
  >> web/sites/default/settings.ddev.php

# Force sqlite
# shellcheck disable=SC2016
printf '\n// Force SQL Lite\n$databases["default"]["default"] = \n[\n    "driver" => "sqlite",\n    "database" => "sites/default/files/.ht.sqlite",\n];' \
  >> web/sites/default/settings.ddev.php

# Install Drupal and enable the Drupal Canvas module.
ddev drupal-install

ddev exec --dir /var/www/html/web/core npm install

ddev composer run ui-build

echo "Development environment ready!"

# Restore original composer.json
mv composer.json.original composer.json

# Display a one time login link for user ID 1.
ddev drush uli
