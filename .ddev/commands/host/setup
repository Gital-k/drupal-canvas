#!/usr/bin/env bash

## #ddev-generated
## Description: Set up the Canvas development environment.
## Usage: setup
## Example: ddev setup\nddev setup --force
## Flags: [{"Name":"force","Shorthand":"f","Usage":"Completely reset an existing environment if present and start over"}]
## ExecRaw: true

set -e

# Flag handling
FORCE=false
while :; do
  case ${1:-} in
    -f | --force)
      FORCE=true ;;
    --)
      shift
      break ;;
    -?*)
      printf 'WARN: Unknown option (ignored): %s\n' "$1" >&2 ;;
    *)
      break ;;
  esac
  shift
done

# Exit early if already set up (unless --force).
# The Drupal scaffold (vendor/, web/core) lives in a Docker volume, not on the
# host, so we track completion with a host-side sentinel instead of checking for
# vendor/autoload.php.
SENTINEL=.ddev/.scaffold-built
if [[ -f "$SENTINEL" ]] && [[ "$FORCE" != true ]]; then
  echo "Development environment already set up."
  echo "Run 'ddev setup --force' to reset and start over."
  exit 0
fi

echo "Setting up Canvas development environment..."

# Mark config.yaml as skip-worktree so local changes don't show in git status.
# This file must exist for ddev to work, but DDEV modifies it on start.
git update-index --skip-worktree .ddev/config.yaml 2>/dev/null || true

# Remove any environment-specific files
ddev cleanup --force

# Install ddev-playwright add-on if not already installed
if [[ ! -f .ddev/config.playwright.yml ]]; then
  echo "Installing ddev-playwright add-on... This will setup playwright and restart ddev one time."
  ddev add-on get Lullabot/ddev-playwright
  cp .ddev/web-build/disabled.Dockerfile.playwright .ddev/web-build/Dockerfile.playwright
  ddev restart
fi

# The Drupal scaffold lives in a Docker volume at /var/www/html; this module is
# bind-mounted at web/modules/contrib/canvas (see docker-compose.inverted.yaml).
# Docker creates the intermediate mount-point directories (web, web/modules,
# web/modules/contrib) in the volume owned by root. Hand them to the container
# user so Composer can populate web/ during install. Do NOT recurse — that would
# touch the bind-mounted module's files.
ddev exec 'sudo chown "$(id -u):$(id -g)" /var/www/html /var/www/html/web /var/www/html/web/modules /var/www/html/web/modules/contrib 2>/dev/null || true'

# Seed the scaffold's Composer root from the module so ddev-drupal-contrib's
# expand step merges Canvas' own require/require-dev into the installed site.
ddev exec 'cp web/modules/contrib/canvas/composer.json composer.json'

# Allow all Composer plugins (operates on the scaffold's composer.json).
ddev composer config \
  --no-plugins \
  allow-plugins.\* \
  true

# Build the Drupal scaffold (core + dependencies) into the volume.
ddev poser

# Mark the scaffold root as a project so `composer run composer-root` resolves
# to /var/www/html from anywhere beneath it (expand writes a drupal-module type).
ddev composer config type project

# `ddev composer run <script>` executes at the scaffold root (/var/www/html),
# but Canvas' scripts (phpstan, phpcs, phpunit, …) were seeded from the module
# and resolve their config relative to the module directory. Rewrite the
# scaffold's copies into delegating shims that `cd` into the module first, so
# `ddev composer run phpstan` works without an explicit --dir. The module's own
# composer.json is untouched (see the helper's @file docblock).
ddev exec 'php /mnt/ddev_config/scripts/shim-scaffold-composer-scripts.php'

# Create simpletest directory for Playwright/PHPUnit test site installations.
ddev exec 'mkdir -p web/sites/simpletest && chmod 777 web/sites/simpletest'

# Write Drupal settings directly into the scaffold volume. DDEV's own settings
# management is disabled (disable_settings_management: true) because with
# no_project_mount it would write settings.php to the empty host docroot instead
# of the volume's real docroot. The settings files are kept under
# .ddev/drupal-settings (mounted at /mnt/ddev_config) and copied in here.
# settings.php includes settings.ddev.php, which holds test-module discovery and
# a forced SQLite database.
ddev exec 'cp /mnt/ddev_config/drupal-settings/settings.php /mnt/ddev_config/drupal-settings/settings.ddev.php web/sites/default/'

# Install Drupal and enable the Drupal Canvas module.
ddev drupal-install

# Node dependencies for Drupal core's JS tooling.
ddev exec --dir /var/www/html/web/core npm install

# Node dependencies for the Canvas monorepo. The npm workspaces root is the
# module, so node_modules lives at the module path and is shared with the host.
ddev exec --dir /var/www/html/web/modules/contrib/canvas npm install

# Build the Canvas UI.
ddev exec --dir /var/www/html/web/modules/contrib/canvas composer run ui-build

echo "Development environment ready!"

# Record that setup completed so it does not re-run on every ddev start.
touch "$SENTINEL"

# Display a one time login link for user ID 1.
ddev drush uli
