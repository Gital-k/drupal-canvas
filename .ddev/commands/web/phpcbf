#!/usr/bin/env bash

## Command provided by https://github.com/ddev/ddev-drupal-contrib
## Description: Run phpcbf inside the web container
## Usage: phpcbf
## Example: "ddev phpcbf"
## ExecRaw: true

set -eu -o pipefail

if ! command -v phpcbf >/dev/null; then
  echo "phpcbf is not available. You may need to run 'ddev setup'"
  exit 1
fi

composer run phpcbf
