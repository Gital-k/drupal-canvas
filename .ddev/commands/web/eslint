#!/usr/bin/env bash

## Command provided by https://github.com/ddev/ddev-drupal-contrib
## Description: Run eslint inside the web container
## Usage: eslint [flags] [args]
## Example: "ddev eslint"
## ExecRaw: true

set -eu -o pipefail

cd ${DDEV_APPROOT}
npm ci
npm run build --workspace=drupal-canvas
npm run lint:eslint
