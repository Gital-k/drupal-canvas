<?php

declare(strict_types=1);

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\canvas_test_state_api\Hook\CanvasTestStateApiHooks;
use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_form_alter().
 */
#[LegacyHook]
function canvas_test_state_api_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  \Drupal::service(CanvasTestStateApiHooks::class)->formAlter($form, $form_state, $form_id);
}
