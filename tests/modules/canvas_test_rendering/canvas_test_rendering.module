<?php

declare(strict_types=1);

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\canvas_test_rendering\Hook\CanvasTestRenderingHooks;
use Drupal\Core\Entity\FieldableEntityInterface;

/**
 * Implements hook_entity_display_build_alter().
 */
#[LegacyHook]
function canvas_test_rendering_entity_display_build_alter(array &$build, array $context): void
{
    \Drupal::service(CanvasTestRenderingHooks::class)->entityDisplayBuildAlter($build, $context);
}
