<?php

/**
 * @file
 * Install file for Canvas Test Templates in Cypress module.
 *
 * Converts the template_basic_setup recipe into programmatic PHP installation.
 */

declare(strict_types=1);

use Drupal\Core\Entity\Entity\EntityFormDisplay;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\file\Entity\File;
use Drupal\filter\Entity\FilterFormat;
use Drupal\media\Entity\Media;
use Drupal\node\Entity\Node;
use Drupal\node\Entity\NodeType;
use Drupal\taxonomy\Entity\Term;
use Drupal\taxonomy\Entity\Vocabulary;
use Drupal\canvas\Entity\ContentTemplate;
use Drupal\Core\File\FileExists;
use Drupal\Core\File\FileSystemInterface;

// cspell:ignore treehouse

/**
 * Implements hook_install().
 */
function canvas_test_templates_in_cypress_install(): void {
  // Ensure dependencies are met.
  $module_installer = \Drupal::service('module_installer');

  // Install required modules if not already installed.
  $required_modules = [
    'node', 'field', 'file', 'image', 'media', 'taxonomy', 'datetime', 'link', 'options', 'filter',
  ];

  foreach ($required_modules as $module) {
    if (!\Drupal::moduleHandler()->moduleExists($module)) {
      $module_installer->install([$module]);
    }
  }

  // Create the tags vocabulary (from core/recipes/tags_taxonomy).
  if (!Vocabulary::load('tags')) {
    $vocabulary = Vocabulary::create([
      'vid' => 'tags',
      'name' => 'Tags',
      'description' => 'Use tags to group articles on similar topics into categories.',
    ]);
    $vocabulary->save();
  }

  // Create page content type if it doesn't exist.
  if (!NodeType::load('page')) {
    $page_type = NodeType::create([
      'type' => 'page',
      'name' => 'Basic page',
      'description' => 'Use basic pages for your static content, such as an "About us" page.',
      'display_submitted' => FALSE,
      'new_revision' => FALSE,
      'preview_mode' => 1,
    ]);
    $page_type->save();
  }

  // Create article content type if it doesn't exist (needed for Canvas templates).
  if (!NodeType::load('article')) {
    $article_type = NodeType::create([
      'type' => 'article',
      'name' => 'Article',
      'description' => 'Use articles for time-sensitive content like news, press releases or blog posts.',
      'display_submitted' => TRUE,
      'new_revision' => TRUE,
      'preview_mode' => 1,
    ]);
    $article_type->save();
  }

  // Create image media type if it doesn't exist.
  if (!\Drupal::entityTypeManager()->getStorage('media_type')->load('image')) {
    // First ensure the image field exists on media entities
    if (!\Drupal::entityTypeManager()->getStorage('field_storage_config')->load('media.field_media_image')) {
      FieldStorageConfig::create([
        'field_name' => 'field_media_image',
        'entity_type' => 'media',
        'type' => 'image',
        'settings' => [
          'uri_scheme' => 'public',
        ],
      ])->save();
    }

    $media_type = \Drupal::entityTypeManager()->getStorage('media_type')->create([
      'id' => 'image',
      'label' => 'Image',
      'description' => 'Use local images for reusable media.',
      'source' => 'image',
      'source_configuration' => [
        'source_field' => 'field_media_image',
      ],
    ]);
    $media_type->save();

    // Add the source field to the media type
    if (!\Drupal::entityTypeManager()->getStorage('field_config')->load('media.image.field_media_image')) {
      FieldConfig::create([
        'field_name' => 'field_media_image',
        'entity_type' => 'media',
        'bundle' => 'image',
        'label' => 'Image',
        'required' => TRUE,
        'settings' => [
          'file_directory' => '',
          'file_extensions' => 'png gif jpg jpeg',
          'max_filesize' => '',
          'max_resolution' => '',
          'min_resolution' => '',
          'alt_field' => TRUE,
          'alt_field_required' => TRUE,
          'title_field' => FALSE,
          'title_field_required' => FALSE,
        ],
      ])->save();
    }
  }

  // Create taxonomy terms.
  _canvas_test_templates_create_taxonomy_terms();

  // Ensure body field exists for content types.
  _canvas_test_templates_ensure_body_fields();

  // Ensure text formats exist.
  _canvas_test_templates_ensure_text_formats();

  // Create field storage and field instances.
  _canvas_test_templates_create_fields();

  // Configure form display.
  _canvas_test_templates_configure_form_display();

  // Create files and media entities.
  $media_entities = _canvas_test_templates_create_media_entities();

  // Create content nodes.
  _canvas_test_templates_create_nodes($media_entities);

  // Create Canvas content templates.
  _canvas_test_templates_create_content_templates();

  // Set last login time for user 2.
  _canvas_test_templates_set_user_last_login();
}

/**
 * Ensures body fields exist for page and article content types.
 */
function _canvas_test_templates_ensure_body_fields(): void {
  // Ensure body field storage exists.
  if (!FieldStorageConfig::loadByName('node', 'body')) {
    FieldStorageConfig::create([
      'field_name' => 'body',
      'entity_type' => 'node',
      'type' => 'text_with_summary',
      'cardinality' => 1,
    ])->save();
  }

  // Add body field to page content type.
  if (!FieldConfig::loadByName('node', 'page', 'body')) {
    FieldConfig::create([
      'field_name' => 'body',
      'entity_type' => 'node',
      'bundle' => 'page',
      'label' => 'Body',
      'settings' => [
        'display_summary' => FALSE,
      ],
    ])->save();
  }

  // Add body field to article content type.
  if (!FieldConfig::loadByName('node', 'article', 'body')) {
    FieldConfig::create([
      'field_name' => 'body',
      'entity_type' => 'node',
      'bundle' => 'article',
      'label' => 'Body',
      'settings' => [
        'display_summary' => TRUE,
      ],
    ])->save();
  }
}

/**
 * Ensures required text formats exist.
 */
function _canvas_test_templates_ensure_text_formats(): void {
  // Create basic_html format if it doesn't exist.
  if (!\Drupal::entityTypeManager()->getStorage('filter_format')->load('basic_html')) {
    FilterFormat::create([
      'format' => 'basic_html',
      'name' => 'Basic HTML',
      'filters' => [
        'filter_html' => [
          'status' => TRUE,
          'weight' => -10,
          'settings' => [
            'allowed_html' => '<a href> <em> <strong> <cite> <blockquote cite> <code> <ul> <ol> <li> <dl> <dt> <dd> <h4> <h5> <h6> <p> <br>',
          ],
        ],
        'filter_autop' => [
          'status' => TRUE,
          'weight' => 0,
        ],
        'filter_url' => [
          'status' => TRUE,
          'weight' => 0,
        ],
        'filter_htmlcorrector' => [
          'status' => TRUE,
          'weight' => 10,
        ],
      ],
    ])->save();
  }
}

/**
 * Creates taxonomy terms.
 */
function _canvas_test_templates_create_taxonomy_terms(): array {
  $terms = [];

  // Cool tag.
  $term1 = Term::create([
    'uuid' => 'ad0f8699-9c47-4d2c-93a2-59729c2e70c1',
    'vid' => 'tags',
    'name' => 'Cool tag',
    'status' => TRUE,
    'weight' => 0,
    'path' => ['alias' => '/tags/cool-tag'],
  ]);
  $term1->save();
  $terms['cool_tag'] = $term1;

  // OK tag.
  $term2 = Term::create([
    'uuid' => '4f797556-f1bd-4bf2-a034-2550afa55c5d',
    'vid' => 'tags',
    'name' => 'Ok tag',
    'status' => TRUE,
    'weight' => 0,
    'path' => ['alias' => '/tags/ok-tag'],
  ]);
  $term2->save();
  $terms['ok_tag'] = $term2;

  return $terms;
}

