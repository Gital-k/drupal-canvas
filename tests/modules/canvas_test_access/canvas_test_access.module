<?php

declare(strict_types=1);

use Drupal\canvas_test_access\Hook\CanvasTestAccessHooks;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Session\AccountInterface;

/**
 * Implements hook_ENTITY_TYPE_access().
 *
 * Denies view access to canvas_page entity with id 1.
 */
#[LegacyHook]
function canvas_test_access_canvas_page_access(EntityInterface $entity, string $operation, AccountInterface $account): AccessResultInterface {
  return \Drupal::service(CanvasTestAccessHooks::class)->canvasPageAccess($entity, $operation, $account);
}
