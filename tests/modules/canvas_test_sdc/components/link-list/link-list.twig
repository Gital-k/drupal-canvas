<div class="link-list-wrapper">

  {% if absolute_urls %}
    <div class="link-section">
      <h3 class="link-section-title">Absolute URLs (URI format)</h3>
      <ul class="link-list">
        {% for url in absolute_urls %}
          <li>
            <a href="{{ url }}" class="link-list-link" target="_blank" rel="noopener">
              {{ url }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}

  {% if urls %}
    <div class="link-section">
      <h3 class="link-section-title">Relative or Absolute URLs</h3>
      <ul class="link-list">
        {% for url in urls %}
          <li>
            <a href="{{ url }}" class="link-list-link">
              {{ url }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}

</div>