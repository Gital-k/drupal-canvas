<?php

/**
 * @file
 * The install file for the canvas distribution.
 */

/**
 * Define the install theme.
 */
define('CANVAS_INSTALL_DEFAULT_THEME', 'shiny');

/**
 * Implements hook_install_tasks().
 */
function canvas_install_tasks($install_state) {
  $task = array();

  return $task;
}

/**
 * Implements hook_install_tasks_alter().
 */
function canvas_install_tasks_alter(&$tasks, $install_state) {

  // Swap the install_finished task for our custom canvas_finished task.
  $tasks['canvas_finished'] = $tasks['install_finished'];
  unset($tasks['install_finished']);

  // Set our maintenance theme as the install theme.
  if ($GLOBALS['theme'] != CANVAS_INSTALL_DEFAULT_THEME) {
    unset($GLOBALS['theme']);

    drupal_static_reset();
    $GLOBALS['conf']['maintenance_theme'] = CANVAS_INSTALL_DEFAULT_THEME;
    _drupal_maintenance_theme();
  }
}

/**
 * Overrides the core install_finished.
 */
function canvas_finished() {
  drupal_set_title(st('@profile installation complete', array('@profile' => drupal_install_profile_distribution_name())), PASS_THROUGH);
  $messages = drupal_set_message();
  $output = '<p>' . st('Your installation of @profile is complete!', array('@profile' => drupal_install_profile_distribution_name())) . '</p>';
  $output .= '<p>' . (isset($messages['error']) ? st('Review the messages above before visiting <a href="@url">your new site</a>.', array('@url' => url(''))) : st('<a href="@url" class="button">Visit your new site</a>', array('@url' => url('')))) . '</p>';

  // Flush all caches to ensure that any full bootstraps during the installer
  // do not leave stale cached data, and that any content types or other items
  // registered by the installation profile are registered correctly.
  variable_set('features_rebuild_on_flush', FALSE);
  drupal_flush_all_caches();

  // Remember the profile which was used.
  variable_set('install_profile', drupal_get_profile());

  // Installation profiles are always loaded last.
  db_update('system')
    ->fields(array('weight' => 1000))
    ->condition('type', 'module')
    ->condition('name', drupal_get_profile())
    ->execute();

  // Cache a fully-built schema.
  drupal_get_schema(NULL, TRUE);

  // Run cron to populate update status tables (if available) so that users
  // will be warned if they've installed an out of date Drupal version.
  // Will also trigger indexing of profile-supplied content or feeds.
  drupal_cron_run();
  variable_set('features_rebuild_on_flush', TRUE);

  return $output;
}
