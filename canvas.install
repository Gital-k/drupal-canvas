      'component_id' => 'sdc.canvas_test_sdc.image',
      'uuid' => '8f6780cd-7b64-499e-9545-321a14951a0d',
      'inputs' => ['image' => ['target_id' => 1]],
    ],
    [
      'parent_uuid' => '16176e0b-8197-40e3-ad49-48f1b6e9a7f9',
      'slot' => 'column_one',
      'component_id' => 'sdc.canvas_test_sdc.my-hero',
